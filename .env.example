# feat/langchain y feat/langgraph
OPENAI_API_KEY=pon_aqui_tu_api_key
OPENAI_MODEL=gpt-6-luna

# Solo feat/langgraph, graphs/v3_postgres.py
POSTGRES_URI=postgresql://usuario:contrasena@localhost:5432/eventhub

# Observabilidad Langfuse. Si faltan, V4 no envía trazas y sigue funcionando.
# El mismo par de claves recupera el prompt eventhub-sistema. No hace falta otra variable.
# La ejecución normal usa la etiqueta production. Las versiones 1 y 2 se piden
# con --version y no cambian esa etiqueta.
# python -m observability.evaluacion usa esas mismas claves para el dataset
# eventhub-12 y los experimentos eventhub-v1 y eventhub-v2.
LANGFUSE_PUBLIC_KEY=pk-lf-pon_aqui_tu_clave_publica
LANGFUSE_SECRET_KEY=sk-lf-pon_aqui_tu_clave_secreta
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Observabilidad LangSmith. No definas también LANGCHAIN_TRACING_V2,
# LANGCHAIN_API_KEY ni LANGCHAIN_PROJECT. El comando no mueve production.
# La nube de Estados Unidos no necesita LANGSMITH_ENDPOINT.
# La nube de Europa sí: https://eu.api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=pon_aqui_tu_api_key
LANGSMITH_PROJECT=thepower-eventhub
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
